# ---------------------------------------------------------------------------
# POS API — Apache config for <document root>/api on cPanel.
#
# This file is deployed with the API. The web build ships its own .htaccess for
# the document root, and those rules stop applying once these take over.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  # No RewriteBase on purpose: Apache resolves the substitution against whatever
  # directory this file sits in, so the API works at <docroot>/api and at the
  # root of a dedicated vhost without editing this line. index.php strips its
  # own mount point to match.

  # Apache does not hand the Authorization header to PHP under CGI/FastCGI
  # unless it is copied explicitly. Without this the relay forwards no
  # credential, the portal answers 401, and sign-in fails for everyone with
  # nothing in the logs to explain it. (Hosts on Apache 2.4.13+ can use
  # `CGIPassAuth On` instead; this form works everywhere.)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # index.php is the only thing in this folder anybody is meant to fetch.
  #
  # The rule below serves any request that names a real file, and every file the
  # API is made of is a real file sitting inside the document root. Without this
  # first rule, https://<host>/api/database/migrations/001_pos_terminals.sql
  # returns the whole schema as plain text to anyone who asks, and
  # https://<host>/api/bin/migrate.php RUNS the migrations for them — printing
  # the database, role and host names in the error if it cannot connect.
  #
  # No RewriteBase, so the pattern is matched against the path relative to this
  # directory, and this works both at <docroot>/api and at a vhost root.
  RewriteRule ^(?:bin|database|src|tests)/ - [R=404,L]

  # Everything that is not a real file goes to the front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# The same four folders again, for a host where mod_rewrite is off or
# AllowOverride does not extend to it. A deployment that silently stopped
# applying the rules above should fail closed, not publish its schema.
<FilesMatch "\.(?:sql|sh|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# --- Hardening -------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header always set Cache-Control "no-store"
</IfModule>

# The API's .env sits inside the document root, so without this it would be
# fetchable over HTTP at https://pos.aicountly.com/api/.env.
RedirectMatch 404 /\.(?!well-known)
